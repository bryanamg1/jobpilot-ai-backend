####################
# SERVER
####################
NODE_ENV=development
PORT=4300
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
AUTOMATION_KILL_SWITCH=false
STORAGE_MODE=auto

####################
# DATABASE
####################
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=job_agent
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_SSL=false

####################
# REDIS
####################
REDIS_URL=

####################
# OPENAI
####################
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_FEATURE_MODE=disabled
OPENAI_REASONING_EFFORT=low
OPENAI_TEXT_VERBOSITY=medium
OPENAI_TIMEOUT_MS=20000

####################
# GMAIL
####################
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_GMAIL_LABEL=Postulaciones/Por revisar
GOOGLE_TOKEN_PATH=storage/tokens/gmail-oauth.json.enc
GOOGLE_GMAIL_ALERT_QUERY=("linkedin" OR "job alert" OR "hiring" OR "vacante" OR "oportunidad laboral") newer_than:30d
GOOGLE_GMAIL_MAX_RESULTS=10

####################
# PLAYWRIGHT
####################
BROWSER_RUNTIME=desktop_agent
BROWSERLESS_WS_URL=
BROWSERLESS_TOKEN=
BROWSERLESS_PROFILE_NAME=
PLAYWRIGHT_HEADLESS=false
BROWSER_SESSION_STATE_DIR=storage/browser-sessions

####################
# DESKTOP AGENT
####################
DESKTOP_AGENT_ENABLED=true
DESKTOP_AGENT_TOKEN=
JOBPILOT_API_URL=http://localhost:4300/api/v1
DESKTOP_AGENT_POLL_INTERVAL_MS=5000
DESKTOP_AGENT_HEARTBEAT_MS=30000

####################
# STORAGE
####################
RESUME_STORAGE_DIR=storage/resumes
RESUME_MAX_BYTES=5242880

####################
# RELIABILITY
####################
EXTERNAL_RETRY_ATTEMPTS=2
EXTERNAL_RETRY_BASE_DELAY_MS=150
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_MS=30000

####################
# OPERATIONS QUEUE
####################
OPERATIONS_QUEUE_NAME=jobpilot-operations
OPERATIONS_QUEUE_RETRY_ATTEMPTS=3
OPERATIONS_QUEUE_RETRY_DELAY_MS=250

####################
# SECURITY
####################
ENCRYPTION_KEY=
